1 ICON "assets/icon.ico"

2 VERSIONINFO
FILEVERSION @SIDELEAF_VERSION_COMMAS@
PRODUCTVERSION @SIDELEAF_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Kortexa AI\0"
      VALUE "FileDescription", "Sideleaf\0"
      VALUE "FileVersion", "@SIDELEAF_VERSION@\0"
      VALUE "InternalName", "Sideleaf\0"
      VALUE "LegalCopyright", "Copyright 2026 Kortexa AI\0"
      VALUE "OriginalFilename", "launcher.exe\0"
      VALUE "ProductName", "Sideleaf\0"
      VALUE "ProductVersion", "@SIDELEAF_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

STRINGTABLE
BEGIN
  101 "Sideleaf"
END
