1 ICON "assets/icon.ico"

// Windows reads executable version metadata from resource ID 1.
1 VERSIONINFO
FILEVERSION @SIDELEAF_VERSION_COMMAS@
PRODUCTVERSION @SIDELEAF_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Kortexa AI"
      VALUE "FileDescription", "Sideleaf"
      VALUE "FileVersion", "@SIDELEAF_VERSION@"
      VALUE "InternalName", "Sideleaf"
      VALUE "LegalCopyright", "Copyright 2026 Kortexa AI"
      VALUE "OriginalFilename", "launcher.exe"
      VALUE "ProductName", "Sideleaf"
      VALUE "ProductVersion", "@SIDELEAF_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

STRINGTABLE
BEGIN
  101 "Sideleaf"
END
